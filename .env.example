ENVIRONMENT=development
WEBHOOK_SIGNING_SECRET=replace-for-local-use
EVENT_TTL_SECONDS=300
COMPANY_EMAIL_DOMAIN=northstar.example
COMPANY_TIMEZONE=America/New_York

# Leave both model keys empty to use the built-in demo model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_FALLBACK_ENABLED=true
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4.1-mini

BI_API_TOKEN=local-bi-token
BI_RATE_LIMIT_PER_MINUTE=60
